<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="using:Avalonia.Input"
             xmlns:vm="using:DBSync.Desktop.ViewModels"
             x:Class="DBSync.Desktop.Views.SyncWorkflowView"
             x:DataType="vm:SyncWorkflowViewModel"
             x:CompileBindings="True">
  <TabControl SelectedIndex="{Binding SelectedTabIndex}">

    <!-- ==================== Tab 1: 导出快照 ==================== -->
    <TabItem Header="导出快照">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="12"
            Margin="16"
            Background="{DynamicResource PageBackgroundBrush}"
            DataContext="{Binding Export}"
            x:DataType="vm:ExportViewModel">

        <!-- 页头 + 工具栏 -->
        <Border Classes="panel" Padding="8">
          <Grid RowDefinitions="Auto,Auto">
            <StackPanel Spacing="2" Margin="0,0,0,10">
              <TextBlock Text="导出快照" Classes="page-title"/>
              <TextBlock Text="将数据库结构与数据导出为可携带的快照文件,支持加密和压缩" Classes="page-subtitle"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding Connections}"
                        SelectedItem="{Binding SelectedConnection}"
                        DisplayMemberBinding="{Binding Name}"
                        MinWidth="200"/>
              <Button Content="加载表" Classes="secondary" Command="{Binding LoadTablesCommand}"/>
              <Button Content="开始导出" Classes="primary" Command="{Binding ExportSnapshotCommand}"/>
              <Button Content="取消" Classes="ghost" Command="{Binding CancelExportCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 主体：表选择 -->
        <Border Grid.Row="1" Classes="panel" Padding="0">
          <Grid RowDefinitions="Auto,Auto,*">
            <Border Padding="12,8" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="表选择" Classes="section-title" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Content="全选" Classes="ghost" Command="{Binding SelectAllTablesCommand}"/>
                  <Button Content="反选" Classes="ghost" Command="{Binding InvertTableSelectionCommand}"/>
                  <Button Content="结构+数据" Classes="ghost" Command="{Binding SelectAllDataModesCommand}"/>
                  <Button Content="仅结构" Classes="ghost" Command="{Binding SelectSchemaOnlyModesCommand}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource Ink50}" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
              <TextBox x:Name="ExportFilterBox" PlaceholderText="按表名或注释过滤..." Text="{Binding TableFilter, Mode=TwoWay}"/>
            </Border>
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FilteredExportTables}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="0"
                      RowHeight="30"
                      FontSize="12">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ExportTableItemViewModel">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="表名" Width="3*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ExportTableItemViewModel">
                      <TextBlock Text="{Binding FullName}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="注释" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ExportTableItemViewModel">
                      <TextBlock Text="{Binding Comment}" FontSize="11" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="行数" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ExportTableItemViewModel">
                      <TextBlock Text="{Binding EstimatedRowCountText}" FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="{DynamicResource Ink600}" VerticalAlignment="Center" TextAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="模式" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ExportTableItemViewModel">
                      <Button Command="{Binding ToggleSyncDataCommand}" Classes="compact" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                        <Border Background="{Binding SyncModeBrush}" CornerRadius="10" Padding="8,2">
                          <TextBlock Text="{Binding SyncModeText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </TabItem>

    <!-- ==================== Tab 2: 加载比对 ==================== -->
    <TabItem Header="加载比对">
      <Grid RowDefinitions="Auto,Auto,*"
            Margin="16"
            Background="{DynamicResource PageBackgroundBrush}"
            DataContext="{Binding Compare}"
            x:DataType="vm:CompareViewModel">

        <!-- 工具栏 -->
        <Border Classes="panel" Padding="12" Margin="0,0,0,12">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="加载比对" Classes="page-title"/>
              <TextBlock Text="将快照文件与目标数据库进行结构与数据比对,生成可执行的 SQL 脚本" Classes="page-subtitle"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="2*,Auto,*,*,Auto,Auto,Auto" ColumnSpacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBox PlaceholderText="快照文件路径" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding CompareSnapshotPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas, Menlo, monospace" FontSize="12"/>
                <Button Grid.Column="1" Content="浏览" Classes="ghost" Command="{Binding BrowseSnapshotCommand}"/>
              </Grid>
              <Button Grid.Column="1" Content="加载快照" Classes="secondary" Command="{Binding LoadSnapshotCommand}"/>
              <TextBox Grid.Column="2" IsVisible="False" PlaceholderText="快照密码（可不填）" PasswordChar="●" input:InputMethod.IsInputMethodEnabled="False" Text="{Binding ComparePassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
              <ComboBox Grid.Column="3" ItemsSource="{Binding CompareConnections}" SelectedItem="{Binding SelectedCompareConnection}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>
              <Button Grid.Column="4" Content="加载表" Classes="secondary" Command="{Binding LoadCompareTablesCommand}"/>
              <Button Grid.Column="5" Content="开始比对" Classes="primary" Command="{Binding RunCompareCommand}"/>
              <Button Grid.Column="6" Content="生成脚本" Classes="success" Command="{Binding GenerateUpgradeScriptCommand}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- 表选择区（紧凑，固定高度） -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,280" ColumnSpacing="8" Margin="0,0,0,8">
          <!-- 快照表 -->
          <Border Classes="panel" Padding="0" MaxHeight="200">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="快照文件表" Classes="section-title" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="全选" Classes="ghost" Command="{Binding SelectAllSnapshotTablesCommand}"/>
                    <Button Content="反选" Classes="ghost" Command="{Binding InvertSnapshotTablesCommand}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <ListBox Classes="WithoutCheck" Grid.Row="1" ItemsSource="{Binding SnapshotCompareTables}" Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#08366FF5"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="8,0" MinHeight="28">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding FullName}" FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Comment}" FontSize="10" Foreground="{DynamicResource Ink400}" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- 数据库表 -->
          <Border Grid.Column="1" Classes="panel" Padding="0" MaxHeight="200">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="当前数据库表" Classes="section-title" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="全选" Classes="ghost" Command="{Binding SelectAllDatabaseTablesCommand}"/>
                    <Button Content="反选" Classes="ghost" Command="{Binding InvertDatabaseTablesCommand}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <ListBox Classes="WithoutCheck" Grid.Row="1" ItemsSource="{Binding DatabaseCompareTables}" Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#08366FF5"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="8,0" MinHeight="28">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding FullName}" FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Comment}" FontSize="10" Foreground="{DynamicResource Ink400}" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- 比对摘要 -->
          <Border Grid.Column="2" Classes="panel" Padding="0" MaxHeight="200">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="比对摘要" Classes="section-title" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="Markdown" Classes="ghost" Command="{Binding ExportMarkdownReportCommand}"/>
                    <Button Content="HTML" Classes="ghost" Command="{Binding ExportHtmlReportCommand}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="6" Margin="8">
                  <TextBlock Text="{Binding CompareSnapshotMetaText}" FontSize="11" Foreground="{DynamicResource Ink700}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ComparePasswordHint}" FontSize="10" Foreground="{DynamicResource Ink400}" TextWrapping="Wrap"/>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding CompareProgress}" Height="4" CornerRadius="2"/>
                  <TextBlock Text="{Binding CompareSummaryText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Ink800}" TextWrapping="Wrap"/>
                  <CheckBox Content="启用事务" IsChecked="{Binding UseTransaction, Mode=TwoWay}" FontSize="12"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- 比对结果：左右分栏 -->
        <Grid Grid.Row="3" ColumnDefinitions="1*,4,*">
          <!-- 左侧：分类按钮 + 差异列表 -->
          <Border Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <!-- 分类按钮组 + 全局 SQL 类型开关 -->
              <Border Padding="4,4" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,260">
                <ListBox x:Name="DiffCategoryList" Classes="WithoutCheck" SelectedIndex="{Binding SelectedDiffTabIndex}" Tapped="DiffCategoryList_Tapped" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="8,4"/>
                      <Setter Property="MinHeight" Value="0"/>
                      <Setter Property="MinWidth" Value="0"/>
                      <Setter Property="CornerRadius" Value="6"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="Foreground" Value="{DynamicResource Ink500}"/>
                      <Setter Property="FontSize" Value="12"/>
                      <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                      <Setter Property="Background" Value="{DynamicResource Ink100}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                      <Setter Property="Foreground" Value="{DynamicResource Brand700}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="全部"/><Border Classes="badge-warning"><TextBlock Text="{Binding AllDiffSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="不同"/><Border Classes="badge-warning"><TextBlock Text="{Binding DifferentSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="快照"/><Border Classes="badge-danger"><TextBlock Text="{Binding OnlySourceSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/></Border>
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="目标"/><Border Classes="badge-success"><TextBlock Text="{Binding OnlyTargetSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></Border>
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="数据"/><Border Classes="badge-warning"><TextBlock Text="{Binding DataDiffSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                    </StackPanel>
                  </ListBoxItem>
                </ListBox>
                <Grid Grid.Column="2" ColumnDefinitions="50,70,70,70" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding GlobalGenerateSchema, Mode=TwoWay}" Command="{Binding RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                    <TextBlock Text="结构" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brand600}"/>
                  </CheckBox>
                  <CheckBox Grid.Column="1" IsChecked="{Binding GlobalGenerateInsert, Mode=TwoWay}" Command="{Binding RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                    <TextBlock Text="新增" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                  </CheckBox>
                  <CheckBox Grid.Column="2" IsChecked="{Binding GlobalGenerateDelete, Mode=TwoWay}" Command="{Binding RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                    <TextBlock Text="删除" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                  </CheckBox>
                  <CheckBox Grid.Column="3" IsChecked="{Binding GlobalGenerateUpdate, Mode=TwoWay}" Command="{Binding RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                    <TextBlock Text="变更" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                  </CheckBox>
                </Grid>
                </Grid>
              </Border>

              <!-- 差异列表 -->
              <ListBox Grid.Row="1" Classes="WithoutCheck" ItemsSource="{Binding CurrentDiffNodes}" SelectedItem="{Binding SelectedDiffItem}" Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#08366FF5"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompareSchemaNodeViewModel">
                    <Grid ColumnDefinitions="Auto,*,260" ColumnSpacing="4" Margin="4,3,4,3">
                      <!-- 勾选 -->
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding $parent[ListBox].DataContext.RefreshDiffSqlCommand}" VerticalAlignment="Center"/>
                      <!-- 表名 -->
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <!-- 表级 SQL 类型开关 -->
                      <Grid Grid.Column="2" ColumnDefinitions="50,70,70,70" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding GenerateSchema, Mode=TwoWay}" Command="{Binding $parent[ListBox].DataContext.RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                          <TextBlock Text="结构" FontSize="10" Foreground="{DynamicResource Brand600}"/>
                        </CheckBox>
                        <CheckBox Grid.Column="1" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateInsert, Mode=TwoWay}" Command="{Binding $parent[ListBox].DataContext.RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                          <TextBlock FontSize="10" Foreground="{DynamicResource SuccessBrush}">
                            <TextBlock.Text><MultiBinding StringFormat="新增{0}"><Binding Path="DataInsertCount"/></MultiBinding></TextBlock.Text>
                          </TextBlock>
                        </CheckBox>
                        <CheckBox Grid.Column="2" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateDelete, Mode=TwoWay}" Command="{Binding $parent[ListBox].DataContext.RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                          <TextBlock FontSize="10" Foreground="{DynamicResource DangerBrush}">
                            <TextBlock.Text><MultiBinding StringFormat="删除{0}"><Binding Path="DataDeleteCount"/></MultiBinding></TextBlock.Text>
                          </TextBlock>
                        </CheckBox>
                        <CheckBox Grid.Column="3" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateUpdate, Mode=TwoWay}" Command="{Binding $parent[ListBox].DataContext.RefreshDiffSqlCommand}" Padding="0" MinWidth="0" MinHeight="0">
                          <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}">
                            <TextBlock.Text><MultiBinding StringFormat="变更{0}"><Binding Path="DataChangeCount"/></MultiBinding></TextBlock.Text>
                          </TextBlock>
                        </CheckBox>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- 拖拽分隔条 -->
          <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                        Background="{DynamicResource Ink200}"/>

          <!-- 右侧：SQL 差异预览 -->
          <Border Grid.Column="2" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
                <TextBlock Text="SQL 差异预览" Classes="section-title" VerticalAlignment="Center"/>
              </Border>
              <TextBox Grid.Row="1"
                       Text="{Binding SelectedDiffSqlText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas, Menlo, monospace" FontSize="12"
                       Foreground="{DynamicResource Ink700}"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="8,4"
                       VerticalAlignment="Stretch"
                       CaretBrush="Transparent"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ==================== Tab 3: 直连比对 ==================== -->
    <TabItem Header="直连比对">
      <Grid RowDefinitions="Auto,*,4,240"
            Margin="16"
            Background="{DynamicResource PageBackgroundBrush}"
            DataContext="{Binding DirectCompare}"
            x:DataType="vm:DirectCompareViewModel">

        <!-- 工具栏 -->
        <Border Classes="panel" Padding="12" Margin="0,0,0,12">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="直连比对" Classes="page-title"/>
              <TextBlock Text="直接连接两个数据库进行结构与数据比对,无需快照文件" Classes="page-subtitle"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="源库" FontSize="12" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedSourceConnection}" DisplayMemberBinding="{Binding Name}" MinWidth="160"/>
              <Button Content="交换" Classes="ghost" Command="{Binding SwapConnectionsCommand}"/>
              <TextBlock Text="目标库" FontSize="12" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedTargetConnection}" DisplayMemberBinding="{Binding Name}" MinWidth="160"/>
              <Button Content="开始比对" Classes="primary" Command="{Binding RunCompareCommand}"/>
              <Button Content="生成脚本" Classes="success" Command="{Binding GenerateScriptCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 比对结果 -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="8">
            <!-- 摘要 -->
            <Border Classes="panel" Padding="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding CompareSummaryText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Ink800}"/>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding CompareProgress}" Height="4" CornerRadius="2"/>
                  <TextBlock Text="{Binding CompareProgressText}" FontSize="11" Foreground="{DynamicResource Ink500}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Content="启用事务" IsChecked="{Binding UseTransaction, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- 两端不同 -->
            <Expander IsExpanded="True">
              <Expander.Header>
                <Border Background="{DynamicResource WarningLightBrush}" Padding="10,6" CornerRadius="8">
                  <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                    <Border Background="{DynamicResource WarningBrush}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="两端不同" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Ink800}"/>
                      <TextBlock Text="结构或索引定义不一致" FontSize="11" Foreground="{DynamicResource Ink500}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge-warning" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DifferentNodes.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                  </Grid>
                </Border>
              </Expander.Header>
              <Border Background="{DynamicResource WarningLightBrush}" BorderBrush="{DynamicResource WarningLightBrush}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,4,0,0">
                <ListBox Classes="WithoutCheck" ItemsSource="{Binding DifferentNodes}" SelectedItem="{Binding SelectedDiffItem}" Background="Transparent" BorderThickness="0">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#11B45309"/></Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,0" MinHeight="34">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink800}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Ink500}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" FontFamily="Consolas, Menlo, monospace" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Expander>

            <!-- 仅源库有 -->
            <Expander>
              <Expander.Header>
                <Border Background="{DynamicResource SuccessLightBrush}" Padding="10,6" CornerRadius="8">
                  <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="仅源库有" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Ink800}"/>
                      <TextBlock Text="源库新增但目标库缺少" FontSize="11" Foreground="{DynamicResource Ink500}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge-success" VerticalAlignment="Center">
                      <TextBlock Text="{Binding OnlySourceNodes.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                  </Grid>
                </Border>
              </Expander.Header>
              <Border Background="{DynamicResource SuccessLightBrush}" BorderBrush="{DynamicResource SuccessLightBrush}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,4,0,0">
                <ListBox Classes="WithoutCheck" ItemsSource="{Binding OnlySourceNodes}" SelectedItem="{Binding SelectedDiffItem}" Background="Transparent" BorderThickness="0">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#11047857"/></Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,0" MinHeight="34">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink800}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Ink500}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" FontFamily="Consolas, Menlo, monospace" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Expander>

            <!-- 仅目标库有 -->
            <Expander>
              <Expander.Header>
                <Border Background="{DynamicResource DangerLightBrush}" Padding="10,6" CornerRadius="8">
                  <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="仅目标库有" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Ink800}"/>
                      <TextBlock Text="目标库新增但源库缺少" FontSize="11" Foreground="{DynamicResource Ink500}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge-danger" VerticalAlignment="Center">
                      <TextBlock Text="{Binding OnlyTargetNodes.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                  </Grid>
                </Border>
              </Expander.Header>
              <Border Background="{DynamicResource DangerLightBrush}" BorderBrush="{DynamicResource DangerLightBrush}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,4,0,0">
                <ListBox Classes="WithoutCheck" ItemsSource="{Binding OnlyTargetNodes}" SelectedItem="{Binding SelectedDiffItem}" Background="Transparent" BorderThickness="0">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#11B91C1C"/></Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,0" MinHeight="34">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink800}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Ink500}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" Foreground="White" FontFamily="Consolas, Menlo, monospace" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Ink200}"/>

        <!-- SQL Diff 面板 -->
        <Border Grid.Row="3" Classes="panel" Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SQL 差异预览" Classes="section-title" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedDiffItem.Title, FallbackValue='选择左侧项查看 SQL'}" FontSize="11" Foreground="{DynamicResource Ink400}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <TextBox Grid.Row="1" Text="{Binding SelectedDiffSqlText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink700}" Background="Transparent" BorderThickness="0" Margin="8"/>
          </Grid>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
