<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBSync.Desktop.ViewModels"
        xmlns:views="using:DBSync.Desktop.Views"
        xmlns:models="using:DBSync.Core.Models"
        x:Class="DBSync.Desktop.Views.ConnectionEditWindow"
        x:DataType="vm:ConnectionEditViewModel"
        x:CompileBindings="True"
        Title="编辑连接"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <!-- 顶部：名称和类型 -->
    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock Text="连接名称" FontWeight="Bold"/>
      <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="输入连接名称"/>
      <TextBlock Text="数据库类型" FontWeight="Bold" Margin="0,8,0,0"/>
      <ComboBox ItemsSource="{x:Static views:ConnectionEditWindow.DbTypes}"
                SelectedItem="{Binding DbType, Mode=TwoWay}"
                HorizontalAlignment="Stretch"/>
    </StackPanel>

    <!-- 中间：TabControl -->
    <TabControl Grid.Row="1" Margin="0,12,0,0">
      <!-- 基本设置 Tab -->
      <TabItem Header="基本设置">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <!-- SQL Server / MySQL / PostgreSQL：服务器地址 -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.NotSqliteConverter}}">
              <TextBlock Text="服务器地址"/>
              <TextBox Text="{Binding Server, Mode=TwoWay}" PlaceholderText="localhost"/>
            </StackPanel>

            <!-- SQLite：文件路径 -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.IsSqliteConverter}}">
              <TextBlock Text="数据库文件路径"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Server, Mode=TwoWay}" PlaceholderText="选择 .db 文件"/>
                <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseSqlitePathCommand}" Margin="4,0,0,0"/>
              </Grid>
            </StackPanel>

            <!-- 端口（非 SQLite） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.NotSqliteConverter}}">
              <TextBlock Text="端口"/>
              <TextBox Text="{Binding Port, Mode=TwoWay}" PlaceholderText="默认端口"/>
            </StackPanel>

            <!-- 数据库名（非 SQLite） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.NotSqliteConverter}}">
              <TextBlock Text="数据库名称"/>
              <TextBox Text="{Binding Database, Mode=TwoWay}" PlaceholderText="输入数据库名"/>
            </StackPanel>

            <!-- Windows 认证（仅 SQL Server） -->
            <CheckBox Content="使用 Windows 集成认证"
                      IsChecked="{Binding UseWindowsAuth, Mode=TwoWay}"
                      IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.IsSqlServerConverter}}"
                      Margin="0,4,0,0"/>

            <!-- 用户名（非 SQLite，非 Windows 认证时） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.NotSqliteConverter}}">
              <TextBlock Text="用户名"/>
              <TextBox Text="{Binding Username, Mode=TwoWay}" PlaceholderText="输入用户名"/>
            </StackPanel>

            <!-- 密码（非 SQLite） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.NotSqliteConverter}}">
              <TextBlock Text="密码"/>
              <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" PlaceholderText="输入密码"/>
            </StackPanel>

            <!-- Schema（仅 PostgreSQL） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.IsPostgreSqlConverter}}">
              <TextBlock Text="Schema"/>
              <TextBox Text="{Binding Schema, Mode=TwoWay}" PlaceholderText="public"/>
            </StackPanel>

            <!-- 字符集（仅 MySQL） -->
            <StackPanel IsVisible="{Binding DbType, Converter={x:Static views:ConnectionEditWindow.IsMySqlConverter}}">
              <TextBlock Text="字符集"/>
              <TextBox Text="{Binding Charset, Mode=TwoWay}" PlaceholderText="utf8mb4"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 高级 Tab -->
      <TabItem Header="高级">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="原始连接字符串" FontWeight="Bold"/>
          <TextBox Text="{Binding RawConnectionString, Mode=TwoWay}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Height="120"
                   PlaceholderText="编辑连接字符串"/>
          <TextBlock Text="额外参数（如 Encrypt=True;TrustServerCertificate=True;）"/>
          <TextBox Text="{Binding AdditionalParameters, Mode=TwoWay}"
                   PlaceholderText="key=value;key2=value2;"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- 底部：测试和操作按钮 -->
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Content="测试连接" Command="{Binding TestConnectionCommand}"/>
        <TextBlock Grid.Column="1" Text="{Binding TestConnectionStatusText}"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="保存" Command="{Binding SaveCommand}" Classes="accent"/>
        <Button Content="取消" Command="{Binding CancelCommand}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
