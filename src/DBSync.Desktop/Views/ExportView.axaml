<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="using:Avalonia.Input"
             xmlns:vm="using:DBSync.Desktop.ViewModels"
             x:Class="DBSync.Desktop.Views.ExportView"
             x:DataType="vm:ExportViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="16">
      <TextBlock Text="导出快照" FontSize="20" FontWeight="SemiBold"/>

      <!-- 1. 选择连接 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="1. 选择连接" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Connections}"
                    SelectedItem="{Binding SelectedConnection}"
                    DisplayMemberBinding="{Binding Name}"
                    HorizontalAlignment="Stretch"/>
          <Button Content="加载表" Command="{Binding LoadTablesCommand}"/>
        </StackPanel>
      </Border>

      <!-- 2. 选择表 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="2. 选择表" FontWeight="SemiBold"/>
          <TextBox PlaceholderText="按表名过滤"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding TableFilter, Mode=TwoWay}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="全选" Command="{Binding SelectAllTablesCommand}"/>
            <Button Content="反选" Command="{Binding InvertTableSelectionCommand}"/>
            <Button Content="模式全选" Command="{Binding SelectAllDataModesCommand}"/>
            <Button Content="全部仅结构" Command="{Binding SelectSchemaOnlyModesCommand}"/>
          </StackPanel>

          <!-- 表列表 -->
          <Border Padding="8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="40,2*,*,*,*,2*" Margin="4">
                <TextBlock Text="选" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="表名" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="预估行数" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="大小" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="模式" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="5" Text="WHERE 条件" FontWeight="SemiBold"/>
              </Grid>
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding FilteredExportTables}"
                       Height="250">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="40,2*,*,*,*,2*" Margin="4">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                      <TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding EstimatedRowCountText}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding DataSizeText}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="4" Spacing="2">
                        <CheckBox Content="结构+数据"
                                  IsChecked="{Binding SyncData, Mode=TwoWay}"
                                  IsEnabled="{Binding HasPrimaryKey}"/>
                        <TextBlock Text="{Binding SyncModeText}" FontSize="12"/>
                      </StackPanel>
                      <TextBox Grid.Column="5"
                               PlaceholderText="不含 WHERE"
                               input:InputMethod.IsInputMethodEnabled="False"
                               Text="{Binding WhereClause, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- 3. 密码和路径 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="3. 密码和路径" FontWeight="SemiBold"/>
          <TextBox PlaceholderText="加密密码（可不填）"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding ExportPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
          <TextBox PlaceholderText="确认密码（可不填）"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding ExportPasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
          <TextBox PlaceholderText="密码提示（明文写入快照文件）"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding PasswordHint, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="导出目录"
                     input:InputMethod.IsInputMethodEnabled="False"
                     Text="{Binding ExportDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsReadOnly="True"/>
            <Button Grid.Column="1" Content="选择路径" Command="{Binding BrowseExportDirectoryCommand}"/>
          </Grid>
          <TextBox PlaceholderText="文件名"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding ExportFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="开始导出" Command="{Binding ExportSnapshotCommand}"/>
            <Button Content="取消" Command="{Binding CancelExportCommand}"/>
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}"/>
          <TextBlock Text="{Binding ExportProgressText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
