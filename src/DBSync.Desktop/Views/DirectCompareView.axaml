<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DBSync.Desktop.ViewModels"
             x:Class="DBSync.Desktop.Views.DirectCompareView"
             x:DataType="vm:DirectCompareViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,2*,4,3*"
        Margin="16"
        Background="{DynamicResource PageBackgroundBrush}">

    <!-- 工具栏 -->
    <Border Classes="panel" Padding="12" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="直连比对" Classes="page-title"/>
          <TextBlock Text="直接连接两个数据库进行结构与数据比对,无需快照文件" Classes="page-subtitle"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="源库" FontSize="12" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedSourceConnection}" DisplayMemberBinding="{Binding ComboDisplayText}" MinWidth="160"/>
          <AutoCompleteBox ItemsSource="{Binding AllSourceDatabases}" SelectedItem="{Binding SelectedSourceDatabaseName}" FilterMode="Contains" MinimumPrefixLength="0" IsTextCompletionEnabled="True" PlaceholderText="选择数据库" MinWidth="140" MaxDropDownHeight="300" FontSize="13" IsEnabled="{Binding !!AllSourceDatabases.Count}"/>
          <Button Content="交换" Classes="ghost" Command="{Binding SwapConnectionsCommand}"/>
          <TextBlock Text="目标库" FontSize="12" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedTargetConnection}" DisplayMemberBinding="{Binding ComboDisplayText}" MinWidth="160"/>
          <AutoCompleteBox ItemsSource="{Binding AllTargetDatabases}" SelectedItem="{Binding SelectedTargetDatabaseName}" FilterMode="Contains" MinimumPrefixLength="0" IsTextCompletionEnabled="True" PlaceholderText="选择数据库" MinWidth="140" MaxDropDownHeight="300" FontSize="13" IsEnabled="{Binding !!AllTargetDatabases.Count}"/>
          <Button Content="加载表" Classes="secondary" Command="{Binding LoadTablesCommand}"/>
          <Button Content="开始比对" Classes="primary" Command="{Binding RunCompareCommand}"/>
          <Button Content="生成脚本" Classes="success" Command="{Binding GenerateScriptCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 表选择区（源库表 | 目标库表 | 比对摘要） -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,280" ColumnSpacing="8">
      <!-- 源库表 -->
      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="源库表" Classes="section-title" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="全选" Classes="ghost" Command="{Binding SelectAllSourceTablesCommand}"/>
                <Button Content="反选" Classes="ghost" Command="{Binding InvertSourceTablesCommand}"/>
                <Button Content="结构+数据" Classes="ghost" Command="{Binding SetSourceAllDataCommand}"/>
                <Button Content="仅结构" Classes="ghost" Command="{Binding SetSourceSchemaOnlyCommand}"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource Ink50}" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <TextBox PlaceholderText="搜索表名..." Text="{Binding SourceTableFilter, Mode=TwoWay}" FontSize="11"/>
          </Border>
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding FilteredSourceTables}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    BorderThickness="0"
                    RowHeight="30"
                    FontSize="12">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="表名" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <TextBlock Text="{Binding FullName}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="注释" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <TextBlock Text="{Binding Comment}" FontSize="11" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="模式" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <Button Command="{Binding ToggleCompareDataCommand}" Classes="compact" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                      <Border Background="{Binding CompareModeBrush}" CornerRadius="10" Padding="8,2">
                        <TextBlock Text="{Binding CompareModText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                      </Border>
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- 目标库表 -->
      <Border Grid.Column="1" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="目标库表" Classes="section-title" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="全选" Classes="ghost" Command="{Binding SelectAllTargetTablesCommand}"/>
                <Button Content="反选" Classes="ghost" Command="{Binding InvertTargetTablesCommand}"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource Ink50}" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <TextBox PlaceholderText="搜索表名..." Text="{Binding TargetTableFilter, Mode=TwoWay}" FontSize="11"/>
          </Border>
          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding FilteredTargetTables}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    BorderThickness="0"
                    RowHeight="30"
                    FontSize="12">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="表名" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <TextBlock Text="{Binding FullName}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="注释" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CompareTableSelectionViewModel">
                    <TextBlock Text="{Binding Comment}" FontSize="11" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- 比对摘要 -->
      <Border Grid.Column="2" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <TextBlock Text="比对摘要" Classes="section-title" VerticalAlignment="Center"/>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="6" Margin="8">
              <TextBlock Text="{Binding CompareSummaryText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Ink800}" TextWrapping="Wrap"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding CompareProgress}" Height="4" CornerRadius="2"/>
              <TextBlock Text="{Binding CompareProgressText}" FontSize="11" Foreground="{DynamicResource Ink500}"/>
              <CheckBox Content="启用事务" IsChecked="{Binding UseTransaction, Mode=TwoWay}" FontSize="12"/>
              <CheckBox Content="排除自增列" IsChecked="{Binding ExcludeIdentityColumns, Mode=TwoWay}" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 拖拽分隔条 -->
    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Ink200}"/>

    <!-- 比对结果：左右分栏 -->
    <Grid Grid.Row="3" ColumnDefinitions="1*,4,*">
      <!-- 左侧：分类按钮 + 差异列表 -->
      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <!-- 分类按钮组 + 全局 SQL 类型开关 -->
          <Border Padding="4,4" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,260">
            <ListBox x:Name="DiffCategoryList" Classes="WithoutCheck" SelectedIndex="{Binding SelectedDiffTabIndex}" Tapped="DiffCategoryList_Tapped" Background="Transparent" BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,4"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="MinWidth" Value="0"/>
                  <Setter Property="CornerRadius" Value="6"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="{DynamicResource Ink500}"/>
                  <Setter Property="FontSize" Value="12"/>
                  <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource Ink100}"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Foreground" Value="{DynamicResource Brand700}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
              </ListBox.Styles>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="全部"/><Border Classes="badge-warning"><TextBlock Text="{Binding AllDiffSchemaNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="不同"/><Border Classes="badge-warning"><TextBlock Text="{Binding DifferentNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="源库"/><Border Classes="badge-danger"><TextBlock Text="{Binding OnlySourceNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/></Border>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="目标"/><Border Classes="badge-success"><TextBlock Text="{Binding OnlyTargetNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></Border>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="数据"/><Border Classes="badge-warning"><TextBlock Text="{Binding DataDiffNodes.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                </StackPanel>
              </ListBoxItem>
            </ListBox>
            <Grid Grid.Column="2" ColumnDefinitions="50,70,70,70" VerticalAlignment="Center">
              <CheckBox IsChecked="{Binding GlobalGenerateSchema, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                <TextBlock Text="结构" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brand600}"/>
              </CheckBox>
              <CheckBox Grid.Column="1" IsChecked="{Binding GlobalGenerateInsert, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                <TextBlock Text="新增" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
              </CheckBox>
              <CheckBox Grid.Column="2" IsChecked="{Binding GlobalGenerateDelete, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                <TextBlock Text="删除" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
              </CheckBox>
              <CheckBox Grid.Column="3" IsChecked="{Binding GlobalGenerateUpdate, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                <TextBlock Text="变更" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
              </CheckBox>
            </Grid>
            </Grid>
          </Border>

          <!-- 差异列表 -->
          <ListBox Grid.Row="1" Classes="WithoutCheck" ItemsSource="{Binding CurrentDiffNodes}" SelectedItem="{Binding SelectedDiffItem}" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#08366FF5"/></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CompareSchemaNodeViewModel">
                <Grid ColumnDefinitions="Auto,*,260" ColumnSpacing="4" Margin="4,3,4,3">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Consolas, Menlo, monospace" FontSize="11" Foreground="{DynamicResource Ink700}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <Grid Grid.Column="2" ColumnDefinitions="50,70,70,70" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding GenerateSchema, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                      <TextBlock Text="结构" FontSize="10" Foreground="{DynamicResource Brand600}"/>
                    </CheckBox>
                    <CheckBox Grid.Column="1" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateInsert, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                      <TextBlock FontSize="10" Foreground="{DynamicResource SuccessBrush}">
                        <TextBlock.Text><MultiBinding StringFormat="新增{0}"><Binding Path="DataInsertCount"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </CheckBox>
                    <CheckBox Grid.Column="2" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateDelete, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                      <TextBlock FontSize="10" Foreground="{DynamicResource DangerBrush}">
                        <TextBlock.Text><MultiBinding StringFormat="删除{0}"><Binding Path="DataDeleteCount"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </CheckBox>
                    <CheckBox Grid.Column="3" IsVisible="{Binding HasDataDiff}" IsChecked="{Binding GenerateUpdate, Mode=TwoWay}" Padding="0" MinWidth="0" MinHeight="0">
                      <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}">
                        <TextBlock.Text><MultiBinding StringFormat="变更{0}"><Binding Path="DataChangeCount"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </CheckBox>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 拖拽分隔条 -->
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource Ink200}"/>

      <!-- 右侧：SQL 差异预览 -->
      <Border Grid.Column="2" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="8,6" BorderBrush="{DynamicResource Ink100}" BorderThickness="0,0,0,1">
            <TextBlock Text="SQL 差异预览" Classes="section-title" VerticalAlignment="Center"/>
          </Border>
          <TextBox Grid.Row="1"
                   Text="{Binding SelectedDiffSqlText}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="Consolas, Menlo, monospace" FontSize="12"
                   Foreground="{DynamicResource Ink700}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="8,4"
                   VerticalAlignment="Stretch"
                   CaretBrush="Transparent"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
