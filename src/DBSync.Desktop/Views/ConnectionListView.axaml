<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="using:Avalonia.Input"
             xmlns:vm="using:DBSync.Desktop.ViewModels"
             x:Class="DBSync.Desktop.Views.ConnectionListView"
             x:DataType="vm:ConnectionListViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,*"
        Margin="16"
        Background="{DynamicResource PageBackgroundBrush}">

    <!-- 页头 -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="2">
        <TextBlock Text="连接管理" Classes="page-title"/>
        <TextBlock Text="管理所有数据库连接,支持 MySQL、PostgreSQL、SQL Server、SQLite" Classes="page-subtitle"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
        <Button Content="新增连接" Classes="primary" Command="{Binding AddConnectionCommand}"/>
        <Button Content="测试连接" Classes="secondary" Command="{Binding TestConnectionCommand}"/>
      </StackPanel>
    </Grid>

    <!-- 选中连接的操作栏 -->
    <Border Grid.Row="1" Classes="panel" Padding="10" Margin="0,0,0,12"
            IsVisible="{Binding SelectedConnection, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="当前选中：" FontSize="12" Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SelectedConnection.Name}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink800}" VerticalAlignment="Center"/>
          <Border CornerRadius="10" Padding="6,1" Background="{DynamicResource DiffLightBrush}" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedConnection.EnvironmentText}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource DiffBrush}"/>
          </Border>
          <Border CornerRadius="10" Padding="6,1" Background="{DynamicResource Brand50}" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedConnection.DbType}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brand700}"/>
          </Border>
          <TextBlock Text="{Binding SelectedConnection.DisplayInfo}"
                     FontFamily="Consolas, Menlo, monospace" FontSize="12"
                     Foreground="{DynamicResource Ink500}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="编辑" Classes="secondary" Command="{Binding EditConnectionCommand}"/>
          <Button Content="删除" Classes="danger" Command="{Binding DeleteConnectionCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 连接卡片网格 -->
    <ScrollViewer Grid.Row="2">
      <ListBox Classes="WithoutCheck" ItemsSource="{Binding Connections}"
               SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="280" Margin="0,0,12,12" Padding="16" CornerRadius="8"
                    Background="White"
                    BorderBrush="{DynamicResource Ink200}"
                    BorderThickness="1"
                    Cursor="Hand">
              <Border.Styles>
                <Style Selector="Border:pointerover">
                  <Setter Property="BorderBrush" Value="{DynamicResource Brand300}"/>
                </Style>
                <Style Selector="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource Ink200}"/>
                </Style>
              </Border.Styles>
              <StackPanel Spacing="10">
                <!-- 名称 + 类型徽章 -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                             Foreground="{DynamicResource Ink900}"
                             TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource DiffLightBrush}">
                      <TextBlock Text="{Binding EnvironmentText}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource DiffBrush}"/>
                    </Border>
                    <Border CornerRadius="10" Padding="8,2"
                            Background="{DynamicResource Brand50}">
                      <TextBlock Text="{Binding DbType}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brand700}"/>
                    </Border>
                  </StackPanel>
                </Grid>

                <!-- 连接信息 -->
                <TextBlock Text="{Binding DisplayInfo}"
                           FontFamily="Consolas, Menlo, monospace" FontSize="12"
                           Foreground="{DynamicResource Ink500}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 底部分隔线 + 服务器地址 -->
                <Border BorderBrush="{DynamicResource Ink100}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                  <TextBlock Text="{Binding Server}"
                             FontFamily="Consolas, Menlo, monospace" FontSize="11"
                             Foreground="{DynamicResource Ink400}"
                             TextTrimming="CharacterEllipsis"/>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </ScrollViewer>
  </Grid>
</UserControl>
