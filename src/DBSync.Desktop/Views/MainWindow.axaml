<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBSync.Desktop.ViewModels"
        xmlns:views="using:DBSync.Desktop.Views"
        x:Class="DBSync.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="DBSyncTool"
        Width="1100"
        Height="760">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- 顶部状态栏 -->
    <Border Padding="12" Background="#1F2937">
      <DockPanel>
        <TextBlock Text="DBSyncTool" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                   Foreground="{Binding StatusIsError, Converter={x:Static views:MainWindow.ErrorForegroundConverter}}"/>
      </DockPanel>
    </Border>

    <!-- 主体：侧边栏 + 内容区 -->
    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <!-- 左侧导航栏 -->
      <Border Background="#1F2937" Padding="0,8">
        <ListBox ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem}"
                 Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="16,12"/>
              <Setter Property="Foreground" Value="#D1D5DB"/>
              <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#374151"/>
              <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Foreground" Value="White"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 右侧内容区 -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
    </Grid>

    <!-- 底部日志栏 -->
    <Border Grid.Row="2" Padding="8" Background="#111827">
      <TextBlock Text="{Binding LogSummary}" Foreground="White"/>
    </Border>
  </Grid>
</Window>
