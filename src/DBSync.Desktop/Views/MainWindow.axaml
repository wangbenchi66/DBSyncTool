<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBSync.Desktop.ViewModels"
        xmlns:views="using:DBSync.Desktop.Views"
        x:Class="DBSync.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="DBSyncTool"
        Width="1100"
        Height="760">
  <Grid RowDefinitions="44,*,36" Background="{DynamicResource PageBackgroundBrush}">
    <!-- 顶部状态栏：白底 + 底边框 + Logo -->
    <Border Background="White"
            BorderBrush="{DynamicResource Ink200}"
            BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0">
        <!-- Logo 区域 -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="6"
                  Background="{DynamicResource Brand600}">
            <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Spacing="0">
            <TextBlock Text="DBSyncTool" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink900}"/>
            <TextBlock Text="v2.0" FontSize="10"
                       Foreground="{DynamicResource Ink400}"/>
          </StackPanel>
        </StackPanel>

        <!-- 右侧状态文字 -->
        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource Ink500}"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- 主体：侧边栏 + 内容区 -->
    <Grid Grid.Row="1" ColumnDefinitions="176,*">
      <!-- 左侧导航栏 -->
      <Border Background="White"
              BorderBrush="{DynamicResource Ink200}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <!-- 导航列表 -->
          <ListBox ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem}"
                   Background="Transparent"
                   Margin="0,8,0,0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="6,1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Ink100}"/>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Brand50}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <Grid ColumnDefinitions="3,*" MinHeight="36">
                  <!-- 左侧选中指示条 -->
                  <Border CornerRadius="2" Width="3" Height="20"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Brand600}"
                          IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                  <!-- 导航文字 -->
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             FontSize="14" Margin="10,0,12,0"
                             VerticalAlignment="Center">
                    <TextBlock.Styles>
                      <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brand700}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </Style>
                      <Style Selector="ListBoxItem:not(:selected) TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Ink600}"/>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 侧边栏底部版本信息 -->
          <Border Grid.Row="1" Padding="14,8"
                  BorderBrush="{DynamicResource Ink200}"
                  BorderThickness="0,1,0,0">
            <TextBlock Text="v2.0.4" FontSize="11"
                       Foreground="{DynamicResource Ink400}"/>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧内容区 -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
    </Grid>

    <!-- 底部日志栏：ink-50 底 + 上边框 -->
    <Border Grid.Row="2" Padding="14,0"
            Background="{DynamicResource Ink50}"
            BorderBrush="{DynamicResource Ink200}"
            BorderThickness="0,1,0,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding LogSummary}"
                   FontSize="12"
                   Foreground="{DynamicResource Ink400}"/>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{Binding StatusIsError, Converter={x:Static views:MainWindow.ErrorForegroundConverter}}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
