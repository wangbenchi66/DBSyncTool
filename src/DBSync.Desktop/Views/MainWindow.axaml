<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:vm="using:DBSync.Desktop.ViewModels"
                 xmlns:views="using:DBSync.Desktop.Views"
                 x:Class="DBSync.Desktop.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 x:CompileBindings="True"
                 Title="DBSyncTool"
                 Width="1100"
                 Height="760"
                 TitleBarControlSize="12"
                 RootCornerRadius="2"
                 ShowBottomBorder="True">
  <suki:SukiWindow.LogoContent>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Border Width="22" Height="22" CornerRadius="5"
              Background="{DynamicResource Brand600}">
        <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Spacing="0">
        <TextBlock Text="DBSyncTool" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink900}"/>
        <TextBlock Text="数据库同步工作台" FontSize="10"
                   Foreground="{DynamicResource Ink500}"/>
      </StackPanel>
    </StackPanel>
  </suki:SukiWindow.LogoContent>
  <suki:SukiWindow.Hosts>
    <suki:SukiToastHost Manager="{Binding ToastManager}"/>
  </suki:SukiWindow.Hosts>
  <Grid Background="{DynamicResource PageBackgroundBrush}">
    <!-- 主体：侧边栏 + 内容区 -->
    <Grid ColumnDefinitions="176,*">
      <!-- 左侧导航栏 -->
      <Border Background="{DynamicResource Ink50}"
              BorderBrush="{DynamicResource Ink200}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <!-- 导航列表 -->
          <ListBox Classes="WithoutCheck" ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem}"
                   Background="Transparent"
                   Margin="0,8,0,0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="6,1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <Grid MinHeight="36">
                  <TextBlock Text="{Binding DisplayName}"
                             FontSize="14" Margin="12,0"
                             VerticalAlignment="Center">
                    <TextBlock.Styles>
                      <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brand700}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </Style>
                      <Style Selector="ListBoxItem:not(:selected) TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Ink600}"/>
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 侧边栏底部版本信息 -->
          <Border Grid.Row="1" Padding="14,8"
                  BorderBrush="{DynamicResource Ink200}"
                  BorderThickness="0,1,0,0">
            <TextBlock Text="v2.0.4" FontSize="11"
                       Foreground="{DynamicResource Ink400}"/>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧内容区 -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
    </Grid>
  </Grid>
</suki:SukiWindow>
