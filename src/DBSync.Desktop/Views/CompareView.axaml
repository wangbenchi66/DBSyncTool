<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="using:Avalonia.Input"
             xmlns:vm="using:DBSync.Desktop.ViewModels"
             x:Class="DBSync.Desktop.Views.CompareView"
             x:DataType="vm:CompareViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="16">
      <TextBlock Text="加载快照并比对" FontSize="20" FontWeight="SemiBold"/>

      <!-- 1. 加载快照文件 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="1. 加载快照文件" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="快照路径"
                     input:InputMethod.IsInputMethodEnabled="False"
                     Text="{Binding CompareSnapshotPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseSnapshotCommand}"/>
          </Grid>
          <TextBlock Text="{Binding ComparePasswordHint}" TextWrapping="Wrap"/>
          <TextBox PlaceholderText="快照密码（可不填）"
                   input:InputMethod.IsInputMethodEnabled="False"
                   Text="{Binding ComparePassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
          <Button Content="加载快照" Command="{Binding LoadSnapshotCommand}"/>
          <TextBlock Text="{Binding CompareSnapshotMetaText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 2. 选择连接并比对 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="2. 选择数据库连接并比对" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding CompareConnections}"
                    SelectedItem="{Binding SelectedCompareConnection}"
                    DisplayMemberBinding="{Binding Name}"
                    HorizontalAlignment="Stretch"/>
          <Button Content="加载数据库表" Command="{Binding LoadCompareTablesCommand}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Padding="8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="快照文件表" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="全选" Command="{Binding SelectAllSnapshotTablesCommand}"/>
                  <Button Content="反选" Command="{Binding InvertSnapshotTablesCommand}"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding SnapshotCompareTables}" Height="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,2*" ColumnSpacing="6" Margin="2">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Comment}" Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="1" Padding="8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="当前数据库表" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="全选" Command="{Binding SelectAllDatabaseTablesCommand}"/>
                  <Button Content="反选" Command="{Binding InvertDatabaseTablesCommand}"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding DatabaseCompareTables}" Height="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,2*" ColumnSpacing="6" Margin="2">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Comment}" Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
          <Button Content="开始比对" Command="{Binding RunCompareCommand}"/>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CompareProgress}"/>
          <TextBlock Text="{Binding CompareProgressText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CompareSummaryText}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox Content="启用事务"
                      IsChecked="{Binding UseTransaction, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <Button Content="生成脚本" Command="{Binding GenerateUpgradeScriptCommand}"/>
            <Button Content="导出 Markdown" Command="{Binding ExportMarkdownReportCommand}"/>
            <Button Content="导出 HTML" Command="{Binding ExportHtmlReportCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 3. 结构差异预览 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="3. 结构差异预览" FontWeight="SemiBold"/>
          <Border Padding="8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding CompareSchemaNodes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="0,2">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Consolas" Margin="6,0,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Children}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="20,2,0,0" ColumnDefinitions="Auto,*,Auto">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Consolas" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <!-- 4. 数据差异预览 -->
      <Border Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="4. 数据差异预览" FontWeight="SemiBold"/>
          <Border Padding="8" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
            <ListBox ItemsSource="{Binding CompareDataSummaries}" Height="220"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="4" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding TableName}" FontFamily="Consolas" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Foreground="{Binding SummaryBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Grid>
                    <Expander Header="差异 SQL" IsVisible="{Binding HasSqlPreview}" IsExpanded="{Binding IsSqlExpanded, Mode=TwoWay}">
                      <TextBox Text="{Binding SqlPreviewText}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="NoWrap"
                               FontFamily="Consolas"
                               Height="120"/>
                    </Expander>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
