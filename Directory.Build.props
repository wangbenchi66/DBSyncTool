<Project>

  <!--
    单一版本源：桌面端/CLI/程序集统一从此读取。
    发布时由 .github/workflows/release.yml 用 -p:Version=<tag 去 v> 覆盖此默认值。
    默认 1.0.0 与首个正式 tag v1.0.0 保持一致。
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

</Project>
